{
  "name": "dedal-example-custom-ds",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dedal": "rm -rf vendor && mkdir vendor && npm pack ../.. --pack-destination vendor && mv vendor/dedal-*.tgz vendor/dedal.tgz && npm install ./vendor/dedal.tgz",
    "demo": "node --import tsx src/demo.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dedal": "file:vendor/dedal.tgz"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
