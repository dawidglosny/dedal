  "features": {
    "component": "section",
    "props": {
      "tone": "default"
    },
    "children": [
      {
        "component": "sectionHeading",
        "props": {
          "subtitle": "Data binding, missing-data rules, caching and debugging — typed and tested, instead of growing them ad hoc around a switch statement.",
          "title": "Everything the hand-rolled version ends up needing.",
          "align": "center",
          "tone": "default"
        },
        "slots": {
          "badge": {
            "component": "badge",
            "props": {
              "label": "WHAT YOU GET",
              "variant": "brand"
            }
          }
        }
      },
      {
        "component": "grid",
        "children": [
          {
            "component": "feature",
            "props": {
              "icon": "braces",
              "description": "A TypeScript contract shared by the server and every frontend. A missing component in the registry is a compile error.",
              "title": "One typed contract"
            }
          },
          {
            "component": "feature",
            "props": {
              "icon": "crosshair",
              "description": "card, #featured, card > :slot(badge). Adding a heading to the template doesn’t shift the data.",
              "title": "Selectors, not indexes"
            }
          },
          {
            "component": "feature",
            "props": {
              "icon": "shield-check",
              "description": "Fewer articles than cards or a failing API: safe defaults, a strict mode, and a report of everything dropped.",
              "title": "Rules for missing data"
            }
          },
          {
            "component": "feature",
            "props": {
              "icon": "git-branch",
              "description": "patch and remove adapt one template per device, site or A/B test.",
              "title": "Variants without copies"
            }
          },
          {
            "component": "feature",
            "props": {
              "icon": "zap",
              "description": "Stale-while-revalidate cache, parallel loaders, streaming. A 530-node page builds in under 1 ms.",
              "title": "Fast by default"
            }
          },
          {
            "component": "feature",
            "props": {
              "icon": "scan-search",
              "description": "Click any element and see where each prop came from, which selector placed the data and what went missing.",
              "title": "Devtools"
            }
          }
        ]
      }
    ]
