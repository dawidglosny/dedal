  "contract": {
    "component": "section",
    "props": {
      "tone": "default"
    },
    "children": [
      {
        "component": "sectionHeading",
        "props": {
          "subtitle": "The registry is the only place that knows your components. Swap Radix for shadcn/ui and the pages stay as they are.",
          "title": "The server and every frontend share one type.",
          "align": "center",
          "tone": "default"
        },
        "slots": {
          "badge": {
            "component": "badge",
            "props": {
              "label": "ONE CONTRACT",
              "variant": "brand"
            }
          }
        }
      },
      {
        "component": "grid",
        "children": [
          {
            "component": "codeBlock",
            "props": {
              "code": "import type { Slot } from 'dedal'\n\n// component → props: the only shared thing\nexport type Contract = {\n  grid: { columns?: 1 | 2 | 3 | 4 }\n  card: { title?: string; href?: string; badge?: Slot }\n  badge: { label?: string }\n}",
              "filename": "contract.ts"
            }
          },
          {
            "component": "codeBlock",
            "props": {
              "code": "import { Render, type Registry } from 'dedal/react'\nimport { Card, Badge } from '@/components/ui'\n\nconst registry = { grid: Grid, card: Card, badge: Badge }\n  satisfies Registry<Contract> // missing one = compile error\n\nexport default async function Home() {\n  return <Render tree={await home()} registry={registry} />\n}",
              "filename": "page.tsx"
            }
          }
        ]
      }
    ]
  },
