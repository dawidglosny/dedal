  "principle": {
    "component": "section",
    "props": {
      "tone": "default"
    },
    "children": [
      {
        "component": "sectionHeading",
        "props": {
          "subtitle": "Structure, data and components have different owners. Dedal joins them at the last moment, so each one can change on its own schedule.",
          "title": "Three things change at different speeds.\nKeep them apart.",
          "align": "center",
          "tone": "default"
        },
        "slots": {
          "badge": {
            "component": "badge",
            "props": {
              "label": "THE IDEA",
              "variant": "brand"
            }
          }
        }
      },
      {
        "component": "grid",
        "children": [
          {
            "component": "feature",
            "props": {
              "icon": "pen-tool",
              "description": "Which blocks, in what order, what sits inside what. Owned by designers and editors — lives in Figma or a CMS.",
              "title": "Structure"
            }
          },
          {
            "component": "feature",
            "props": {
              "icon": "database",
              "description": "What is inside the blocks. Comes from your APIs and is placed by CSS-like selectors, not fragile indexes.",
              "title": "Data"
            }
          },
          {
            "component": "feature",
            "props": {
              "icon": "component",
              "description": "What a card or a button looks like. Owned by the UI team — your design system, untouched.",
              "title": "Components"
            }
          }
        ]
      }
    ]
  },
