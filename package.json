{
  "name": "dedal",
  "version": "0.9.0",
  "private": true,
  "description": "Dedal \u2014 a server-driven UI engine independent of framework and component library",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js"
    },
    "./devtools/panel": {
      "types": "./dist/devtools/panel.d.ts",
      "import": "./dist/devtools/panel.js"
    },
    "./figma": {
      "types": "./dist/figma/index.d.ts",
      "import": "./dist/figma/index.js"
    },
    "./react/devtools": {
      "types": "./dist/react/devtools.d.ts",
      "import": "./dist/react/devtools.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "dedal-figma": "./bin/dedal-figma.mjs",
    "dedal-mcp": "./bin/dedal-mcp.mjs"
  },
  "files": [
    "dist",
    "bin",
    "skills"
  ],
  "scripts": {
    "build": "tsup",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "bench": "npm run build && node --expose-gc bench/bench.mjs",
    "docs:types": "typedoc"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.9"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@valibot/to-json-schema": "^1.8.0",
    "ajv": "^8.20.0",
    "happy-dom": "^21.0.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.5.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3",
    "valibot": "^1.5.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  }
}
